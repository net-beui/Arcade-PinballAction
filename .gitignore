# ============================================================

*.bak
*.bak1
*.bak2
*.orig
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# Personal source snapshots and manual baselines
# Use Git commits/tags instead of keeping these files in the repo
# ============================================================

*.Baseline*
*.FirstTimeBooting
*.TryToFixBallIssue
*.BaselineGoodColours
*.BaselineBooting
*.BaselineNew
*.BaselineFirstSound
*.BaselineNext
*.BaselineSoundGood
*.BaselineTitleScreenAlmostPerfect
*.sal

# ============================================================
# SignalTap generated or stripped files
# Keep hand-authored .stp files if you want them in the repo
# ============================================================

*_auto_stripped.stp

# ============================================================
# Local framework or project backups
# ============================================================

sys_backup/

