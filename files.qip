# Top-level emu wrapper
set_global_assignment -name SYSTEMVERILOG_FILE PinballAction.sv

# SDC timing constraints
set_global_assignment -name SDC_FILE PinballAction.sdc

# PLL IP
set_global_assignment -name QIP_FILE rtl/pll/pll.qip

# T80 Z80 CPU core
set_global_assignment -name QIP_FILE sys/t80/t80.qip

# Core RTL
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pbaction.sv
set_global_assignment -name VERILOG_FILE       rtl/pbaction_cpu.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pbaction_sound.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pbaction_video.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pbaction_fg.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pbaction_bg.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pbaction_sprites.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pbaction_palette.v
set_global_assignment -name VERILOG_FILE sys/arcade_video.v

# Memory primitives
set_global_assignment -name VERILOG_FILE       rtl/dpram.v

set_global_assignment -name VERILOG_FILE rtl/jt49/jt49.v
set_global_assignment -name VERILOG_FILE rtl/jt49/jt49_bus.v
set_global_assignment -name VERILOG_FILE rtl/jt49/jt49_cen.v
set_global_assignment -name VERILOG_FILE rtl/jt49/jt49_div.v
set_global_assignment -name VERILOG_FILE rtl/jt49/jt49_eg.v
set_global_assignment -name VERILOG_FILE rtl/jt49/jt49_exp.v
set_global_assignment -name VERILOG_FILE rtl/jt49/jt49_noise.v